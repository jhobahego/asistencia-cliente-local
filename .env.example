OLLAMA_MODEL=qwen2.5:3b-instruct-q4_K_M
OLLAMA_BASE_URL=http://localhost:11434
API_PORT=8000
RAG_TOP_K=4
TEMPERATURE=0.2

# Ollama timeouts (seconds): 300/400 on a CPU-only cold start; 60-120 / 120-180 with an NVIDIA GPU and a larger model.
OLLAMA_TIMEOUT=300
OLLAMA_STREAM_TIMEOUT=400

# Embeddings: nomic-embed-text needs the search_document:/search_query:
# prefixes (handled in api/embeddings.py). Changing the model requires a
# full re-index: python -m api.ingest --reset
OLLAMA_EMBED_MODEL=nomic-embed-text

# Retrieval gate: distance <= RAG_MAX_DISTANCE AND
# (distance <= RAG_STRONG_DISTANCE OR lexical evidence > 0). Calibrated for
# nomic-embed-text on this FAQ; re-measure after changing models or docs.
RAG_MAX_DISTANCE=0.50
RAG_STRONG_DISTANCE=0.25
LLM_CONCURRENCY_LIMIT=1
EMBED_BATCH_SIZE=32
CHROMA_DB_PATH=./chroma_db
CHROMA_COLLECTION=asistencia_cliente_kb
KNOWLEDGE_BASE_DIR=./knowledge_base
